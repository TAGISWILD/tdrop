{
  "name": "tdrop",
  "version": "1.0.0",
  "description": "Ultra-fast, ephemeral, authless file-sharing from your terminal",
  "bin": {
    "tdrop": "./dist/bin.js"
  },
  "main": "./dist/bin.js",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "cli",
    "file-sharing",
    "ephemeral",
    "transfer",
    "upload",
    "npx",
    "terminal",
    "developer-tools",
    "cloudflared",
    "r2"
  ],
  "homepage": "https://tdrop.link",
  "license": "MIT",
  "scripts": {
    "build": "esbuild src/bin.ts --bundle --platform=node --target=node18 --format=esm --packages=external --outfile=dist/bin.js && chmod +x dist/bin.js",
    "clean": "rm -rf dist",
    "test": "vitest run"
  },
  "dependencies": {
    "cli-progress": "^3.12.0",
    "commander": "^12.1.0",
    "ora": "^8.1.0",
    "undici": "^6.20.0"
  },
  "devDependencies": {
    "@tdrop/shared": "*",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^22.7.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.2"
  }
}
