# .dotvetignore
# Ignore shell script local variables and optional dev variables from dotvet check

# Shell script internal variables (scripts/install.sh, scripts/build-binaries.sh)
ASSET_NAME
BINARY_NAME
BOLD
CYAN
DIR
EXT
GREEN
INSTALL_DIR
PLATFORM
RED
REPO
RESET
TARGET_ARCH
TARGET_OS
TAR_NAME
TMP_DIR
VERSION
YELLOW

# Optional / dev environment overrides
PORT
CLAMD_HOST
CLAMD_PORT
CLAMD_SOCKET
R2_ENDPOINT
R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY
R2_BUCKET_NAME
TDROP_SERVER
